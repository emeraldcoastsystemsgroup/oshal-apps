# Copy to ~/.config/oshal-store-gate/full-run.env and fill in. Read by oshal-store-full-run.service.
# The store clone that runs scripts/store-full-run.sh (it fetches origin there; its tree is not tested).
STORE_CLONE=/home/USER/oshal-work/store-full-run
# The kernel exports a push uses (read-only `git archive` of the commit production runs).
OSHAL_CORE_ROOT=/home/USER/.local/state/oshal-store-gate/core-SHA8
# The kernel platform pin the packages run on (it must hold src/shared/ui).
STORE_CI_KERNEL_PLATFORM=/home/USER/.local/state/oshal-store-gate/kernel-platform-SHA8/platform
# Where receipts go (this is the default).
STORE_FULL_RUN_RECEIPTS=/home/USER/.local/state/oshal-store-gate/full-runs
PATH=/home/USER/.local/bin:/usr/local/bin:/usr/bin:/bin
