#!/usr/bin/env bash
# =============================================================================
# CHANGE LOG
# -----------------------------------------------------------------------------
# SEQ                 | AUTHOR                                     | DESCRIPTION
# -----------------------------------------------------------------------------
# 1 | maintainer@emeraldcoastsystemsgroup.com   | Refuse model attribution in the commit messages this push publishes. The operator's standing directive is that work identifies the LANE, never a model, and the core trunk has enforced it at push time since the 2026-09-12 history scrub (scripts/publish-gate.sh, run from its .githooks/pre-push). This repo had no push-time check at all: a harness session's default trailer and tool footer went straight into history, and the only way to notice was for someone to grep. Scope is exactly the commits this push publishes - history the remote already holds is out of scope by construction, because removing it is an operator-run rewrite and a gate that refused every push until then would halt all work. Enable with: git config core.hooksPath .githooks
# 2 | maintainer@emeraldcoastsystemsgroup.com   | Scan the tracked tree at push time as well (SCAN_TREE now defaults to 1). Entry 1 shipped with the tree check off because this repo still carried 165 attributed lines and a hook that refused every push over content it did not introduce would have halted all work. Those lines are gone in this same change - the COLLABORATE.md bylines name the lane and the four Change Log AUTHOR cells name the house identity - so the hook now holds the tree clean instead of waiting for CI to notice. It runs the SPEC rather than the scanner, so one command proves both halves: every rule still red on its fixture, and this tree green.
# 3 | maintainer@emeraldcoastsystemsgroup.com   | Run the store CI gate here too. store-ci.yml just lost its `pull_request:` trigger (PRIVATE repo, billed minutes) and security.yml was already workflow_dispatch-only, so that trigger was the LAST automatic gate in this repository: there is no root package.json, required status checks are unavailable on this plan, and nothing but prose referenced scripts/store-ci-local.sh. Replacing an enforced gate with a documented habit is strictly worse than what it replaced, so the habit gets teeth here. Note the hook itself is opt-in per clone (`git config core.hooksPath .githooks`) and was NOT configured on the operator's checkout when this landed - the attribution gate above was inert there too.
# 4 | maintainer@emeraldcoastsystemsgroup.com   | The store CI gate brings its own toolchain (`npm ci --prefix scripts/toolchain`) and no longer resolves the old TypeScript platform checkout, so the skip list below names the toolchain and the LEGACY checks instead of "no kernel checkout". OSHAL_ROOT / OSHAL_FRAMEWORK / NODE_PATH on the push command line are now ignored by the gate.
# 5 | maintainer@emeraldcoastsystemsgroup.com   | The store CI gate is scoped by default (Roger, 2026-11-14: "we ran the full suite today, we dont need to do it every time"): the publish wall and every structural rule, plus the suites of the packages this branch changes or reaches; anything the gate cannot place runs everything. OSHAL_STORE_CI_FULL=1 runs every job. STORE_CI_RETRY_FROM names a first run's result so a second try reruns only the jobs that failed (store-push.sh sets it). The hook's own last line names the mode, so a scoped pass never reads as a full one. The attribution checks above run on every push whatever the mode, and OSHAL_STORE_CI_LOCAL=0 still skips only the store CI gate.
# =============================================================================
set -uo pipefail

say()  { printf '%s\n' "$*" >&2; }
fail=0
bad()  { say "  ✗ $*"; fail=1; }
ok()   { say "  ✓ $*"; }

say ""
say "attribution gate: the commits this push publishes"

# ── 1. The set of commits this push publishes ────────────────────────────────
# git writes one "<local ref> <local sha> <remote ref> <remote sha>" line per pushed ref on stdin.
# A push BY SHA publishes commits HEAD never reaches, so the pushed set - not HEAD's unpublished
# commits - is the only correct scope.
PUSH_LINES="$(cat || true)"
PUSHED=""
if [ -n "$PUSH_LINES" ]; then
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] && [ -n "${lsha//0/}" ] || continue   # blank, or all zeros: a deletion publishes nothing
    ALREADY=""
    if [ -n "${rsha:-}" ] && [ -n "${rsha//0/}" ] && git cat-file -e "${rsha}^{commit}" 2>/dev/null; then
      ALREADY="$rsha"
    fi
    if ! PART="$(git rev-list "$lsha" --not --remotes $ALREADY 2>/dev/null)"; then
      bad "cannot list the commits this push publishes for ${lsha} - refusing rather than scanning nothing"
      continue
    fi
    [ -n "$PART" ] && PUSHED="${PUSHED}${PART}"$'\n'
  done <<< "$PUSH_LINES"
else
  # No stdin (a manual invocation): fall back to HEAD's unpublished commits so the hook is testable.
  PUSHED="$(git rev-list HEAD --not --remotes 2>/dev/null || true)"
fi
PUSHED="$(printf '%s\n' "$PUSHED" | awk 'NF && !seen[$0]++')"

# ── 2. Model attribution in those messages ───────────────────────────────────
# Matched on the IDENTIFIER in the shapes a session actually produces:
#   - a '-by:' trailer (Co-Authored-By, Co-authored-by, Assisted-by, ...) whose value names the
#     vendor or the model, at any address. The sanctioned house identity
#     "Co-authored-by: oshal maintainers <maintainer@emeraldcoastsystemsgroup.com>" names neither
#     and is unaffected;
#   - the vendor no-reply address anywhere in the message;
#   - 'generated with / by / using / via' followed by the model: the tool footer, link or no link.
# `grep -a` so a message is always read as text; LC_ALL=C so case folding behaves the same
# everywhere. Deliberately NOT filtered on '<...>': every trailer carries its address in brackets.
ATTRIB_RE='^[[:space:]]*[a-z]+([-_ ][a-z]+)*[-_ ]by[[:space:]]*:.*(claude|anthropic)|no-?reply@([a-z0-9-]+\.)*anthropic\.com|generated[[:space:]]+(with|by|using|via)[^[:alnum:]]*claude'
ATTRIB_HITS=""
ATTRIB_FIXES=""
if [ -z "$PUSHED" ]; then
  ok "no unpublished commit messages to scan"
else
  for sha in $PUSHED; do
    if ! MSG="$(git show -s --format='%B' "$sha" 2>/dev/null)"; then
      bad "cannot read the message of pushed commit $sha - refusing rather than passing it unread"
      continue
    fi
    HIT="$(printf '%s\n' "$MSG" | LC_ALL=C grep -aiE "$ATTRIB_RE" | head -3 || true)"
    [ -n "$HIT" ] || continue
    SHORT="$(git rev-parse --short "$sha")"
    ATTRIB_HITS="${ATTRIB_HITS}${SHORT} $(git log -1 --format='%s' "$sha")"$'\n'"$(printf '%s\n' "$HIT" | sed 's/^/    /')"$'\n'
    ATTRIB_FIXES="${ATTRIB_FIXES}          ${SHORT}:  git rebase -i ${SHORT}~1   (mark it 'reword'), or git commit --amend if it is your branch tip"$'\n'
  done
  if [ -n "$ATTRIB_HITS" ]; then
    bad "model attribution in unpublished COMMIT MESSAGE(s) - none is allowed in this repository:"
    printf '%s' "$ATTRIB_HITS" | sed 's/^/       /' >&2
    say "      -> Delete those lines from each message, then push again:"
    printf '%s' "$ATTRIB_FIXES" >&2
    say "        Built with git commit-tree (private index)? Rebuild it with a clean -F message instead."
    say "        Never push with --no-verify: this is the only push-time wall this repo has."
  else
    ok "no model attribution in unpublished commit messages"
  fi
fi

# ── 3. Model attribution in the tracked TREE ─────────────────────────────────
# Set per repo, because the two repos are not in the same state:
#   SCAN_TREE=1  this repo's tracked tree is clean, so the hook holds it clean at push time.
#   SCAN_TREE=0  the tree check runs in CI instead (see CONTRIBUTING.md); running it here would
#                refuse every push over content this hook did not introduce.
# This repo is on SCAN_TREE=1: the 165 attributed lines it carried were rewritten in the same
# change that added this hook, so the hook holds a tree that is already clean.
#
# It runs the SPEC, not the scanner, so one command proves both halves: that the detector still
# detects (every rule red on its fixture) and that this tree is clean. Weakening a rule to let one
# file through therefore turns the gate red on the fixtures instead of passing quietly.
SCAN_TREE=${OSHAL_ATTRIBUTION_SCAN_TREE:-1}
SPEC="$(git rev-parse --show-toplevel)/scripts/check-no-model-attribution.test.mjs"
if [ "$SCAN_TREE" = "1" ]; then
  if [ ! -f "$SPEC" ]; then
    bad "the tree guard is missing ($SPEC) - refusing rather than passing unchecked"
  elif ! command -v node >/dev/null 2>&1; then
    bad "node is not on PATH, so the tracked tree could not be scanned - refusing rather than passing unchecked"
  elif ! OUT="$(node --test "$SPEC" 2>&1)"; then
    bad "the tree guard failed - model attribution in TRACKED FILES, or a rule that no longer detects:"
    printf '%s\n' "$OUT" | tail -40 | sed 's/^/       /' >&2
  else
    ok "no model attribution in tracked files (and every rule still detects)"
  fi
fi

say ""
if [ "$fail" -ne 0 ]; then
  say "ATTRIBUTION GATE FAILED. Work identifies the LANE, never a model (operator directive)."
  exit 1
fi

# ── 4. The store CI gate ─────────────────────────────────────────────────────
# store-ci.yml is workflow_dispatch-only (PRIVATE repo, billed Actions minutes), and security.yml
# already was. This hook is therefore the ONLY automatic gate left in the repository - there is no
# root package.json, no required status check on this plan, and nothing else invokes
# scripts/store-ci-local.sh. A documented habit is not a gate; this line is what makes it one.
#
# SCOPED BY DEFAULT. The gate runs the publish wall (attribution, house identifiers, the public
# snapshot cut) and every structural rule on every push, plus the suites of the packages this branch
# changes since its merge base with origin/main and the packages that require, optionally use or read
# them. A change under scripts/, .github/ or .githooks/, a shared root file, an unknown folder or a job
# the mapper cannot place runs everything. The whole suite runs on a schedule
# (scripts/store-full-run.sh) and whenever it is asked for here.
#
#   OSHAL_STORE_CI_FULL=1         run every store-ci job, whatever changed.
#   STORE_CI_RETRY_FROM=<file>    a first run's result (STORE_CI_RESULT_FILE): rerun only the jobs that
#                                 failed there, plus the publish wall, when the tree is the same and the
#                                 failures were package suites. Otherwise the whole plan runs again.
#   OSHAL_STORE_CI_LOCAL=0        skip the store CI gate entirely. An emergency valve, not a workflow.
#                                 The attribution checks above run regardless. Same idiom as
#                                 OSHAL_ATTRIBUTION_SCAN_TREE above.
#   OSHAL_STORE_CI_ALLOW_SKIPS=1  accept checks that cannot run on this box (toolchain not installed
#                                 - `npm ci --prefix scripts/toolchain` -, no disposable PostgreSQL, no symlink
#                                 privilege). They are still printed. Without it, a check that did not
#                                 run fails the push - which is the point: a skipped security suite is
#                                 not a green one. LEGACY checks and the live Embodied suites never block.
RUN_STORE_CI=${OSHAL_STORE_CI_LOCAL:-1}
GATE="$(git rev-parse --show-toplevel)/scripts/store-ci-local.sh"
if [ "$RUN_STORE_CI" = "1" ]; then
  if [ ! -f "$GATE" ]; then
    say "  ✗ the store CI gate is missing ($GATE) - refusing rather than pushing unchecked"
    exit 1
  fi
  GATE_ARGS=()
  [ "${OSHAL_STORE_CI_ALLOW_SKIPS:-0}" = "1" ] && GATE_ARGS+=(--allow-skips)
  if [ "${OSHAL_STORE_CI_FULL:-0}" = "1" ]; then
    GATE_ARGS+=(--full)
    say "store CI gate: every store-ci job (OSHAL_STORE_CI_FULL=1), against this working tree"
  else
    say "store CI gate: scoped to this change, against this working tree (OSHAL_STORE_CI_FULL=1 runs every job)"
  fi
  [ -n "${STORE_CI_RETRY_FROM:-}" ] && GATE_ARGS+=(--retry-from "$STORE_CI_RETRY_FROM")
  RESULT_FILE=${STORE_CI_RESULT_FILE:-}
  OWN_RESULT=""
  if [ -z "$RESULT_FILE" ]; then
    RESULT_FILE="$(mktemp "${TMPDIR:-/tmp}/store-ci-result.XXXXXX")" && OWN_RESULT="$RESULT_FILE"
  fi
  STORE_CI_RESULT_FILE="$RESULT_FILE" bash "$GATE" "${GATE_ARGS[@]}" >&2
  GATE_STATUS=$?
  # The mode and the counts come from the gate's own result, not from what was asked for: a scoped
  # request the mapper could not place ran everything, and the line below says which one ran.
  MODE_LINE="$(node -e 'const r=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.stdout.write(r.mode==="scoped"
      ? `scoped: ${r.jobs.run.length} of ${r.jobs.total} jobs, ${r.checks.run} of ${r.checks.total} checks; ${r.jobs.left.length} jobs left to the scheduled full run`
      : `full suite: ${r.checks.run} of ${r.checks.total} checks`)' "$RESULT_FILE" 2>/dev/null || true)"
  [ -n "$OWN_RESULT" ] && rm -f "$OWN_RESULT"
  if [ "$GATE_STATUS" -eq 0 ]; then
    say "  ✓ store CI gate passed (${MODE_LINE:-mode unknown: read the last line of the gate above})"
  else
    say ""
    say "STORE CI GATE FAILED${MODE_LINE:+ ($MODE_LINE)}. Fix it, or re-run with the prerequisite it named."
    say "Never push with --no-verify: with store-ci.yml on workflow_dispatch, nothing else checks this."
    exit 1
  fi
else
  say "store CI gate: SKIPPED by OSHAL_STORE_CI_LOCAL=0 - nothing checked this push beyond the attribution gate"
fi

exit 0
